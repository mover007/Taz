	"authors": ["mTaz"],
	"contact": {
		"homepage": "https://github.com/mover007/Taz",
		"sources": "https://github.com/mover007/Taz",
		"issues": "https://github.com/mover007/Taz/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/taz/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.taz.Taz"],
		"modmenu": ["com.taz.compat.ModMenuIntegration"]
	},
	"mixins": ["taz.mixins.json"],
	"accessWidener": "taz.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.12"
	},
	"breaks": {
		"dungeonpredictor": "*",
		"skyblockxpassist": "*"
