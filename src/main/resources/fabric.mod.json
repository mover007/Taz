{
	"schemaVersion": 1,
	"id": "taz",
	"version": "${version}",
	"name": "Taz",
	"description": "mTaz's SkyBlock features in one mod: dungeon run timer and end-time prediction, Galatea grown-tree highlight, and the cheapest SkyBlock XP list with an NPC tracker. Settings: /taz.",
	"authors": ["mTaz"],
	"license": "MIT",
	"icon": "assets/taz/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.taz.Taz"],
		"modmenu": ["com.taz.compat.ModMenuIntegration"]
	},
	"mixins": ["taz.mixins.json"],
	"accessWidener": "taz.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.12"
	},
	"breaks": {
		"dungeonpredictor": "*",
		"skyblockxpassist": "*"
	}
}
