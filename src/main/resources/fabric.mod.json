		"modmenu": ["com.taz.compat.ModMenuIntegration"]
	},
	"mixins": ["taz.mixins.json"],
	"accessWidener": "taz.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.12"
	},
	"breaks": {
		"dungeonpredictor": "*",
		"skyblockxpassist": "*"
